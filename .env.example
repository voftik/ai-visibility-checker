OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-opus-5
OPENROUTER_ANALYSIS_MODEL=anthropic/claude-opus-5
OPENROUTER_PROCESSING_MODEL=openai/gpt-5.6-terra
OPENROUTER_CRITIC_MODEL=google/gemini-3.6-flash
OPENROUTER_ORCHESTRATOR_MODEL=anthropic/claude-fable-5
PIPELINE_ORCHESTRATOR_ENABLED=false
PIPELINE_ORCHESTRATOR_MAX_CALLS_PER_RUN=2
PIPELINE_ORCHESTRATOR_MAX_INPUT_CHARS=0
OPENROUTER_ILLUSTRATION_CONCEPT_MODEL=anthropic/claude-opus-5
OPENROUTER_IMAGE_MODEL=google/gemini-3-pro-image
OPENROUTER_OPENAI_MODEL=openai/gpt-chat-latest
OPENROUTER_GEMINI_MODEL=google/gemini-3.6-flash
OPENROUTER_PERPLEXITY_MODEL=perplexity/sonar-pro-search
OPENROUTER_DEEPSEEK_MODEL=deepseek/deepseek-v4-pro
OPENROUTER_CLAUDE_MODEL=anthropic/claude-sonnet-5
OPENROUTER_TIMEOUT_SECONDS=180
OPENROUTER_READ_TIMEOUT_SECONDS=7200
OPENROUTER_PANEL_CONCURRENCY=5
FINAL_INPUT_TOKEN_BUDGET=0
SITE_PREVIEW_WORKER_COMMAND=
HOST=0.0.0.0
PORT=8000
DEFAULT_CONCURRENCY=8
DEFAULT_TIMEOUT_SECONDS=20
AUDIT_PAGE_LIMIT=8
RUN_QUEUE_MAX_PENDING=20
RUN_LEASE_SECONDS=90
RUN_COORDINATOR_POLL_SECONDS=3

# Webshare.io proxy pool (optional).
# Leave WEBSHARE_API_KEY empty to disable proxying — crawler will talk directly.
WEBSHARE_API_KEY=
PROXY_ENABLED=true
PROXY_REFRESH_INTERVAL_SECONDS=3600
PROXY_FALLBACK_DIRECT=true
PROXY_COOLDOWN_SECONDS=300
